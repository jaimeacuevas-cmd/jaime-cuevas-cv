jc:VOC_0001 a skos:Concept ;
    rdfs:label "Humanidades Digitales" ;
    skos:definition "Campo metodológico que aplica herramientas computacionales, modelado de datos y visualizaciones al patrimonio y la cultura." .

jc:VOC_0002 a skos:Concept ;
    rdfs:label "Web Semántica y Linked Open Data (LOD)" ;
    skos:definition "Publicación de datos interconectados bajo estándares W3C (RDF, SPARQL, Ontologías) para interoperabilidad abierta." .

jc:VOC_0003 a skos:Concept ;
    rdfs:label "CIDOC-CRM (ISO 21127)" ;
    skos:definition "Estándar ontológico formal para la integración y mediación de información sobre patrimonio cultural." .

jc:VOC_0004 a skos:Concept ;
    rdfs:label "Microhistoria Urbana" ;
    skos:definition "Análisis cualitativo y cuantitativo a escala micro de la arquitectura, nomenclatura y memoria en el espacio de la ciudad." .

jc:VOC_0005 a skos:Concept ;
    rdfs:label "Pensamiento Decolonial" ;
    skos:definition "Perspectiva crítica que deconstruye las narrativas eurocéntricas y la colonialidad del saber en colecciones y museos." .

jc:VOC_0006 a skos:Concept ;
    rdfs:label "Subalternidad y Representación Afromestiza" ;
    skos:definition "Estudio de las representaciones visuales y ausencias de sujetos racializados e indígenas en la construcción visual de la nación." .

jc:VOC_0007 a skos:Concept ;
    rdfs:label "Perspectiva de Género y Discipulaje Femenino" ;
    skos:definition "Revalorización de la agencia de mujeres artistas históricamente subordinadas bajo categorías androcéntricas." .

jc:VOC_0008 a skos:Concept ;
    rdfs:label "Geografía del Mercado del Arte" ;
    skos:definition "Mapeo espacial de la oferta, tasación, especulación, coleccionismo y circulación de bienes artísticos." .

jc:VOC_0009 a skos:Concept ;
    rdfs:label "Logística Clavo a Clavo y Conservación Preventiva" ;
    skos:definition "Gestión integral del riesgo, embalaje, pólizas de seguro y traslado de alta complejidad de obras patrimoniales." .

jc:VOC_0010 a skos:Concept ;
    rdfs:label "Descentralización e Itinerancia Territorial" ;
    skos:definition "Circulación de acervos artísticos estatales hacia regiones fuera de la capital para democratizar el acceso." .

jc:VOC_0011 a skos:Concept ;
    rdfs:label "Accesibilidad Universal Web (WCAG)" ;
    skos:definition "Diseño de experiencias y plataformas digitales accesibles para personas con discapacidad bajo pautas W3C WCAG 2.1/2.2 AA." .

jc:VOC_0012 a skos:Concept ;
    rdfs:label "Retrato y Modos de Representación" ;
    skos:definition "Género artístico centrado en la representación de la individualidad o el colectivo y sus implicancias ideológicas de poder y género." .

jc:VOC_0013 a skos:Concept ;
    rdfs:label "Catalogación Razonada y Catastro Curatorial" ;
    skos:definition "Investigación sistemática y documental exhaustiva de la totalidad del corpus de un artista o acervo." .

jc:VOC_0014 a skos:Concept ;
    rdfs:label "Salones Oficiales y Construcción de Identidad Nacional" ;
    skos:definition "Espacios seculares de consagración artística y legitimación ideológica del Estado-nación decimonónico." .

jc:VOC_0015 a skos:Concept ;
    rdfs:label "Memoria Política, Archivo y Derechos Humanos" ;
    skos:definition "Uso testimonial y estético de la imagen para la denuncia, memoria histórica y resguardo de los derechos humanos." .

jc:VOC_0016 a skos:Concept ;
    rdfs:label "Geografía Crítica y Redefinición del Paisaje" ;
    skos:definition "Análisis espacial de las transformaciones territoriales, ecológicas y políticas a través del arte contemporáneo." .

jc:VOC_0017 a skos:Concept ;
    rdfs:label "Museografía Crítica y Pigmentocracia" ;
    skos:definition "Prácticas expográficas que interpelan la jerarquización eurocéntrica y racializada en la exhibición del patrimonio." .

jc:VOC_0018 a skos:Concept ;
    rdfs:label "Fuentes Primarias y Archivo Histórico" ;
    skos:definition "Metodología historiográfica basada en la consulta directa, transcripción y análisis crítico de documentos originales." .

jc:VOC_0019 a skos:Concept ;
    rdfs:label "Imagenología y Peritaje Técnico Material" ;
    skos:definition "Análisis físico-químico y óptico no destructivo de capas pictóricas y soportes para autenticación y conservación." .

jc:VOC_0020 a skos:Concept ;
    rdfs:label "Descripción Archivística y Norma ISAD(G)" ;
    skos:definition "Estándar internacional de descripción de fondos y colecciones de archivos históricos para acceso abierto." .

jc:VOC_0021 a skos:Concept ;
    rdfs:label "Arte, Ciencia y Riesgo Socioambiental" ;
    skos:definition "Prácticas transdisciplinares entre artes visuales y ciencias de la tierra para la denuncia y modelación de crisis." .

